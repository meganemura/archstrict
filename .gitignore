# Local-only project instructions
CLAUDE.local.md

# Task specs and worker reports. Never referenced from committed content.
.claude-team/

node_modules/
dist/

# A fixture's own workspace dependency: TS's real node module resolution
# looks for a directory literally named `node_modules`, so this can't be
# renamed - only the fixture's own subtree is un-ignored.
!test/fixtures/package-resolution/node_modules/
!test/fixtures/package-resolution/node_modules/**
!test/fixtures/types-shadow-package/node_modules/
!test/fixtures/types-shadow-package/node_modules/**
!test/fixtures/type-leak-node-modules/node_modules/
!test/fixtures/type-leak-node-modules/node_modules/**

# Hegel failure database
.hegel/

# headsign's per-run scratch state
.headsign/tmp/

# spike 4's throwaway single-config tsconfig, regenerated each run
spike/fixtures/generated-union/tsconfig.oneoff.json
.nukadoko/
.env
.env.*
!.env.example

# nuka accept's own acceptance records for the nukadoko dogfood scenario:
# its steps' returned values legitimately include the mkdtemp scratch
# path each run creates, so any accepted record embeds a machine-local
# path and cannot be committed clean. report.md carries the durable,
# path-free record of a passing run instead.
features/*.md

coverage/

# Stryker copies the project into a sandbox and writes the mutation report
# beside it. Neither belongs in git.
reports/
.stryker-tmp/
stryker.log
