{
  "name": "archstrict",
  "version": "0.2.0",
  "description": "TypeScript module boundary checker: default-private module surfaces, layers, cycles, and a todo freeze that can only shrink.",
  "keywords": [
    "architecture",
    "boundaries",
    "typescript",
    "lint",
    "module",
    "agent",
    "claude-code"
  ],
  "license": "MIT",
  "author": "meganemura",
  "repository": {
    "type": "git",
    "url": "https://github.com/meganemura/archstrict.git"
  },
  "homepage": "https://github.com/meganemura/archstrict#readme",
  "bugs": {
    "url": "https://github.com/meganemura/archstrict/issues"
  },
  "type": "module",
  "bin": {
    "archstrict": "./dist/cli.js"
  },
  "files": [
    "README.md",
    "README.ja.md",
    "CHANGELOG.md",
    "AGENTS.md",
    "LICENSE",
    "dist",
    "docs",
    "skills",
    "llms.txt",
    ".agents"
  ],
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --testTimeout=60000",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "dogfood:nukadoko": "npm run build && nuka run features",
    "ci:ts7-probe": "node scripts/probe-typescript7.mjs",
    "mutation": "stryker run",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@hegeldev/hegel": "0.4.5",
    "@meganemura/depug": "0.1.3",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "26.5.1",
    "@vitest/coverage-v8": "5.0.0",
    "nukadoko": "0.12.0",
    "stryker-agent-reporter": "0.1.0",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
